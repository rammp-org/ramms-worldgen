{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1",
	"FriendlyName": "RammsWorldGen",
	"Description": "Procedural, seed-driven generation and randomization of pedestrian / wheelchair environments for RAMMS: street networks, sidewalks with curb ramps and hazards, building massing with entrances, suburban lots and parks, and indoor layouts with doors and furniture. Built on UE 5.8 PCG with custom nodes, a swappable asset palette, an ADA-derived accessibility profile, and a ground-truth manifest per generated world. Exposed to AI assistants through the in-editor MCP server.",
	"Category": "Data Collection & Simulation",
	"CreatedBy": "ATDev",
	"CreatedByURL": "github.com/rammp-org/ramms-worldgen",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "RammsWorldGen",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "PCG",
			"Enabled": true
		},
		{
			"Name": "GeometryScripting",
			"Enabled": true
		},
		{
			"Name": "PythonScriptPlugin",
			"Enabled": true
		}
	]
}
